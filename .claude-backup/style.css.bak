@import 'tailwindcss';
@plugin "daisyui";

/* html {
	background-color: #0f1419;
} */

@theme {
	--font-main: 'Montserrat', sans-serif;
}

@font-face {
	font-family: 'Montserrat';
	src: url('./fonts/MontserratAlternates-Bold.woff2') format('woff2');
	font-weight: 700;
	font-style: normal;
	font-display: swap;
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
	-webkit-box-shadow: 0 0 0 1000px #1d232a inset !important;
	-webkit-text-fill-color: #ffffff !important;
	caret-color: #ffffff;
	transition: background-color 5000s ease-in-out 0s;
}

#preloader {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: #111214;
	display: flex;
	justify-content: center;
	align-items: center;
	z-index: 9999;
	transition: opacity 0.5s ease;
}

.spinner {
	width: 50px;
	height: 50px;
	border: 5px solid #f3f3f3;
	border-top: 5px solid #3498db;
	border-radius: 50%;
	animation: spin 2s linear infinite;
}

@keyframes spin {
	0% {
		transform: rotate(0deg);
	}
	100% {
		transform: rotate(3deg);
	}
}

#link_result {
	overflow: hidden;
	max-height: 0;
	opacity: 0;
	transition:
		max-height 0.35s ease,
		opacity 0.25s ease;
}

#link_result.open {
	max-height: 400px;
	opacity: 1;
}

html,
body {
	scrollbar-width: thin !important; /* Для Firefox */
	scrollbar-color: #27272a #08090b !important; /* Для Firefox (ползунок и трек) */
}

/* 1. Настройка всей полосы прокрутки (Chrome, Safari, Edge, Opera, Яндекс) */
html::-webkit-scrollbar,
body::-webkit-scrollbar,
::-webkit-scrollbar {
	width: 10px !important;
	height: 10px !important;
	display: block !important;
}

/* 2. Фон дорожки */
html::-webkit-scrollbar-track,
body::-webkit-scrollbar-track,
::-webkit-scrollbar-track {
	background: #08090b !important;
}

/* 3. Сам ползунок */
html::-webkit-scrollbar-thumb,
body::-webkit-scrollbar-thumb,
::-webkit-scrollbar-thumb {
	background: #27272a !important;
	border-radius: 9999px !important;
	/* Делаем небольшой отступ внутри дорожки для изящности */
	border: 2px solid #08090b !important;
}

/* 4. Ползунок при наведении мыши */
html::-webkit-scrollbar-thumb:hover,
body::-webkit-scrollbar-thumb:hover,
::-webkit-scrollbar-thumb:hover {
	background: #3f3f46 !important;
}
